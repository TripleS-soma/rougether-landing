---
// FAQ 아코디언 — 문구는 i18n 사전(Landing.astro가 넘김). FAQPage JSON-LD도 같은 목록에서 생성된다.
import type { FaqItem } from '../i18n';
interface Props { heading: string; items: FaqItem[]; reward: string }
const { heading, items, reward } = Astro.props;
---

<section class="faq" id="faq">
  <div class="wrap reveal">
    <h2>{heading}</h2>
    <div class="list">
      {items.map((item) => (
        <details>
          <summary>{item.q}</summary>
          {item.html ? <p set:html={item.html} /> : <p>{item.a}</p>}
        </details>
      ))}
    </div>
    <!-- 이스터에그 ③: 전부 열면 등장 (로직은 EasterCats.astro) -->
    <div class="faq-reward" id="faq-reward" hidden>
      <img data-src="/assets/cats/sit-wink.webp" alt="" width="130" />
      <p>{reward}</p>
    </div>
  </div>
</section>
