---
// 친구 초대(invite)·집 초대(join) 공용 카드 — 문구·딥링크 스킴만 다르다.
// 문구는 ko로 렌더하고(og·크롤러 기준), 브라우저 언어가 한국어가 아니거나 ?lang=en이면
// 아래 인라인 스크립트가 data-i18n 요소를 영어로 바꾼다 (rougether-mobile#1369).
import type { InviteCopy } from '../i18n';
import { APP_STORE, WEB_APP } from '../lib/links';

interface Props {
  copy: Record<'ko' | 'en', InviteCopy>;
  scheme: string; // 딥링크 경로: 'invite' | 'join'
  placement: string; // GA appstore_tap placement
  visual: 'emoji' | 'mark';
}
const { copy, scheme, placement, visual } = Astro.props;
const ko = copy.ko;
---

<main class="card">
  {visual === 'emoji' ? (
    <div class="emoji">🎁</div>
  ) : (
    <img class="mark" src="/assets/icon.png" alt={ko.iconAlt} data-i18n-alt="iconAlt" />
  )}
  <h1 data-i18n="heading">{ko.heading}</h1>
  <p class="lead" data-i18n="lead">{ko.lead}</p>

  <div id="with-code">
    <div class="code-box" id="code">········</div>
    <div class="code-hint" data-i18n="hint">{ko.hint}</div>
    <div id="accept-actions">
      <a class="btn" id="open-app" href="#" data-i18n="openApp">{ko.openApp}</a>
      <a class="btn web" id="open-web" href={`${WEB_APP}/${scheme}`} data-web-cta={`${placement}-web`} data-i18n="openWeb">{ko.openWeb}</a>
    </div>
    <button class="btn ghost" id="copy-code" type="button" data-i18n="copyCode">{ko.copyCode}</button>
  </div>
  <div id="no-code" class="no-code">
    <p class="lead" data-i18n="noCode">{ko.noCode}</p>
  </div>

  <div class="install">
    <span data-i18n="installLead">{ko.installLead}</span>
    <a class="store-link" href={APP_STORE} target="_blank" rel="noopener" data-cta={placement} data-i18n="appStore">{ko.appStore}</a> ·
    <span>Google Play<span class="soon">준비 중</span></span>
    <br />
    <a class="home-link" href="/" id="home-link" data-i18n="whatIs">{ko.whatIs}</a>
  </div>
</main>

<script is:inline define:vars={{ scheme, copy, webApp: WEB_APP }}>
  // ?code=XXXX → rougether://<scheme>?code=XXXX 딥링크로 앱 열기. 미설치면
  // 아무 일도 일어나지 않으므로 코드·설치 안내가 그대로 남는다.
  // 언어 결정 — 루트(index)와 같은 규칙: ?lang= → localStorage('rougether.lang') → 브라우저 언어.
  var strings = copy.ko;
  (function () {
    try {
      var q = new URLSearchParams(location.search).get('lang');
      if (q === 'ko' || q === 'en') { localStorage.setItem('rougether.lang', q); }
      var chosen = q || localStorage.getItem('rougether.lang');
      var en = chosen === 'en';
      if (!chosen) {
        var langs = navigator.languages || [navigator.language || ''];
        en = !langs.some(function (l) { return /^ko/i.test(l); });
      }
      if (!en) return;
      strings = copy.en;
      document.documentElement.lang = 'en';
      document.title = strings.title;
      var desc = document.querySelector('meta[name="description"]');
      if (desc) desc.setAttribute('content', strings.description);
      document.querySelectorAll('[data-i18n]').forEach(function (el) {
        var v = strings[el.getAttribute('data-i18n')];
        if (v) el.textContent = v;
      });
      document.querySelectorAll('[data-i18n-alt]').forEach(function (el) {
        var v = strings[el.getAttribute('data-i18n-alt')];
        if (v) el.setAttribute('alt', v);
      });
      // 영어 방문자는 영어 랜딩으로 (루트는 브라우저 언어로 다시 보내지만 명시가 빠르다).
      var home = document.getElementById('home-link');
      if (home) home.setAttribute('href', '/en.html');
    } catch (e) {}
  })();
  (function () {
    var code = new URLSearchParams(location.search).get('code');
    code = code ? code.trim().toUpperCase() : '';
    if (!code) {
      document.getElementById('with-code').style.display = 'none';
      document.getElementById('no-code').style.display = 'block';
      return;
    }
    var deepLink = 'rougether://' + scheme + '?code=' + encodeURIComponent(code);
    document.getElementById('code').textContent = code;
    var openBtn = document.getElementById('open-app');
    openBtn.setAttribute('href', deepLink);
    // 웹앱(app.rougether.com)도 같은 경로(/invite·/join)에서 코드를 받아 로그인 뒤 확인 시트로
    // 이어간다 (rougether-mobile#1377). 데스크톱은 앱이 없으니 웹 버튼을 주 버튼(위)으로.
    var webBtn = document.getElementById('open-web');
    webBtn.setAttribute('href', webApp + '/' + scheme + '?code=' + encodeURIComponent(code));
    var mobile = /android|iphone|ipad/i.test(navigator.userAgent);
    if (!mobile) openBtn.parentNode.insertBefore(webBtn, openBtn);
    document.getElementById('copy-code').addEventListener('click', function () {
      var btn = this;
      navigator.clipboard.writeText(code).then(function () {
        btn.textContent = strings.copied;
        setTimeout(function () { btn.textContent = strings.copyCode; }, 1500);
      });
    });
    // 모바일에서 열렸으면 한 번 자동 시도 — 실패해도 페이지가 그대로 안내한다.
    if (mobile) {
      setTimeout(function () { location.href = deepLink; }, 400);
    }
  })();
</script>

<style is:global>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: 'NanumSquareRound', -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
    color: var(--text);
    background: linear-gradient(180deg, var(--sky) 0%, var(--screen) 62%);
    line-height: 1.7;
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    padding: 24px;
  }
  .card {
    width: 100%; max-width: 420px; text-align: center;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 24px; padding: 40px 28px 32px;
    box-shadow: 0 10px 30px rgba(74, 64, 58, 0.08);
  }
  .emoji { font-size: 56px; }
  .mark { width: 64px; height: 64px; border-radius: 16px; margin: 0 auto; display: block; }
  h1 { margin-top: 14px; font-size: 24px; line-height: 1.4; }
  p.lead { margin-top: 8px; color: var(--text-muted); font-size: 16px; }
  .code-box {
    margin: 22px auto 0; padding: 14px 18px;
    border: 1.5px dashed var(--border); border-radius: 14px;
    background: var(--surface-muted);
    font-size: 24px; font-weight: 800; letter-spacing: 4px;
  }
  .code-hint { margin-top: 8px; font-size: 13px; color: var(--text-muted); }
  .btn {
    display: block; margin-top: 20px; padding: 14px 20px;
    border: 0; border-radius: 999px; width: 100%;
    background: var(--primary); color: #fff;
    font-size: 16px; font-weight: 700; text-decoration: none; cursor: pointer;
    font-family: inherit;
  }
  .btn:hover { background: var(--primary-active); }
  /* 웹에서 초대 받기 — 앱 버튼(세이지 그린)과 구분되는 진한 갈색. */
  .btn.web { background: var(--text); }
  #accept-actions .btn + .btn { margin-top: 10px; }
  .btn.ghost {
    background: var(--surface); color: var(--text);
    border: 1.5px solid var(--border); font-weight: 600;
  }
  .install {
    margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--border);
    font-size: 14px; color: var(--text-muted);
  }
  .install .soon {
    display: inline-block; margin-left: 6px; font-size: 11px; font-weight: 600;
    color: var(--warning-text); background: color-mix(in srgb, var(--warning) 20%, transparent);
    padding: 1px 8px; border-radius: 999px;
  }
  .home-link { display: inline-block; margin-top: 14px; font-size: 14px; color: var(--primary-text); }
  .store-link { color: var(--primary-text); font-weight: 700; }
  .no-code { display: none; }
</style>
