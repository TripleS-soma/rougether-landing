---
// 친구 초대(invite)·집 초대(join) 공용 카드 — 문구·딥링크 스킴만 다르다.
interface Props {
  heading: string;
  lead: string;
  hint: string;
  scheme: string; // 딥링크 경로: 'invite' | 'join'
  placement: string; // GA appstore_tap placement
  visual: 'emoji' | 'mark';
}
const { heading, lead, hint, scheme, placement, visual } = Astro.props;
const APP_STORE = 'https://apps.apple.com/kr/app/%EB%A3%A8%EA%B2%8C%EB%8D%94/id6793513720';
---

<main class="card">
  {visual === 'emoji' ? (
    <div class="emoji">🎁</div>
  ) : (
    <img class="mark" src="/assets/icon.png" alt="루게더 앱 아이콘" />
  )}
  <h1>{heading}</h1>
  <p class="lead">{lead}</p>

  <div id="with-code">
    <div class="code-box" id="code">········</div>
    <div class="code-hint">{hint}</div>
    <a class="btn" id="open-app" href="#">앱에서 초대 받기</a>
    <button class="btn ghost" id="copy-code" type="button">초대코드 복사</button>
  </div>
  <div id="no-code" class="no-code">
    <p class="lead">초대코드가 링크에 없어요. 친구에게 링크를 다시 받아주세요.</p>
  </div>

  <div class="install">
    아직 루게더가 없다면 —
    <a class="store-link" href={APP_STORE} target="_blank" rel="noopener" data-cta={placement}>App Store에서 받기</a> ·
    <span>Google Play<span class="soon">준비 중</span></span>
    <br />
    <a class="home-link" href="/">루게더가 뭔가요? →</a>
  </div>
</main>

<script is:inline define:vars={{ scheme }}>
  // ?code=XXXX → rougether://<scheme>?code=XXXX 딥링크로 앱 열기. 미설치면
  // 아무 일도 일어나지 않으므로 코드·설치 안내가 그대로 남는다.
  (function () {
    var code = new URLSearchParams(location.search).get('code');
    code = code ? code.trim().toUpperCase() : '';
    if (!code) {
      document.getElementById('with-code').style.display = 'none';
      document.getElementById('no-code').style.display = 'block';
      return;
    }
    var deepLink = 'rougether://' + scheme + '?code=' + encodeURIComponent(code);
    document.getElementById('code').textContent = code;
    var openBtn = document.getElementById('open-app');
    openBtn.setAttribute('href', deepLink);
    document.getElementById('copy-code').addEventListener('click', function () {
      var btn = this;
      navigator.clipboard.writeText(code).then(function () {
        btn.textContent = '복사됐어요 ✓';
        setTimeout(function () { btn.textContent = '초대코드 복사'; }, 1500);
      });
    });
    // 모바일에서 열렸으면 한 번 자동 시도 — 실패해도 페이지가 그대로 안내한다.
    if (/android|iphone|ipad/i.test(navigator.userAgent)) {
      setTimeout(function () { location.href = deepLink; }, 400);
    }
  })();
</script>

<style is:global>
  /* Rougether cozy tokens (src/constants/theme.ts) */
  :root {
    --app-shell: #E8DCC8;
    --screen: #FBF8F3;
    --surface: #FFFFFF;
    --surface-muted: #F5F1E8;
    --border: #E8DCC8;
    --text: #4A403A;
    --text-muted: #8B7E74;
    --primary: #7FA87F;
    --primary-active: #6D926D;
    --primary-text: #517751;
    --warning: #E8A24A;
    --warning-text: #9D6014;
    --sky: #C3E0F5;
    --grass: #B5D89A;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Apple SD Gothic Neo", "Noto Sans KR", sans-serif;
    color: var(--text);
    background: linear-gradient(180deg, var(--sky) 0%, var(--screen) 62%);
    line-height: 1.7;
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    padding: 24px;
  }
  .card {
    width: 100%; max-width: 420px; text-align: center;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 24px; padding: 40px 28px 32px;
    box-shadow: 0 10px 30px rgba(74, 64, 58, 0.08);
  }
  .emoji { font-size: 56px; }
  .mark { width: 64px; height: 64px; border-radius: 16px; margin: 0 auto; display: block; }
  h1 { margin-top: 14px; font-size: 22px; line-height: 1.4; }
  p.lead { margin-top: 8px; color: var(--text-muted); font-size: 15px; }
  .code-box {
    margin: 22px auto 0; padding: 14px 18px;
    border: 1.5px dashed var(--border); border-radius: 14px;
    background: var(--surface-muted);
    font-size: 24px; font-weight: 800; letter-spacing: 4px;
  }
  .code-hint { margin-top: 8px; font-size: 12px; color: var(--text-muted); }
  .btn {
    display: block; margin-top: 20px; padding: 14px 20px;
    border: 0; border-radius: 999px; width: 100%;
    background: var(--primary); color: #fff;
    font-size: 16px; font-weight: 700; text-decoration: none; cursor: pointer;
    font-family: inherit;
  }
  .btn:hover { background: var(--primary-active); }
  .btn.ghost {
    background: var(--surface); color: var(--text);
    border: 1.5px solid var(--border); font-weight: 600;
  }
  .install {
    margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--border);
    font-size: 13px; color: var(--text-muted);
  }
  .install .soon {
    display: inline-block; margin-left: 6px; font-size: 11px; font-weight: 600;
    color: var(--warning-text); background: color-mix(in srgb, var(--warning) 20%, transparent);
    padding: 1px 8px; border-radius: 999px;
  }
  .home-link { display: inline-block; margin-top: 14px; font-size: 13px; color: var(--primary-text); }
  .store-link { color: var(--primary-text); font-weight: 700; }
  .no-code { display: none; }
</style>
