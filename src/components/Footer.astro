---
import { INSTAGRAM, GITHUB, WEB_APP } from '../lib/links';
import { t, type Locale } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'ko' } = Astro.props;
const d = t(locale);
---

<footer>
  <div class="wrap foot">
    <div class="info">
      <div class="links">
        <a href="/privacy.html">{d.footer.privacy}</a>
        <a href="/terms.html">{d.footer.terms}</a>
        <a href={GITHUB}>{d.footer.github}</a>
        <!-- 데스크톱 이용자용 웹앱 진입. 아웃바운드 클릭은 GA 향상된 측정이 자동 수집. -->
        <a href={WEB_APP}>{d.footer.web}</a>
      </div>
      <div class="copy">© 2026 Rougether · TripleS</div>
    </div>
    <div class="sns">
      <a href={INSTAGRAM} target="_blank" rel="noopener" aria-label={d.footer.instagramLabel}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><rect x="2.7" y="2.7" width="18.6" height="18.6" rx="5.4"/><circle cx="12" cy="12" r="4.4"/><circle cx="17.4" cy="6.6" r="1.2" fill="#fff" stroke="none"/></svg>
      </a>
    </div>
  </div>
</footer>
