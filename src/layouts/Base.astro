---
// 모든 페이지가 공유하는 문서 골격 — 메타·파비콘·폰트·GA. 페이지별 태그는 head 슬롯으로.
import '../styles/tokens.css';
import '../styles/fonts.css';
import { GA_ID, PLAY_STORE } from '../lib/links';

// 메타 광고 도착(utm_source=meta) 전용 스토어 직행. 트래픽 캠페인은 스토어 URL을 광고에 못 넣어(#1487810)
// 랜딩으로 보내는데, 첫날 실측에서 사람 방문의 약 11%만 스토어 배지를 눌렀다. 모바일 기기면 랜딩을 그리지 않고
// utm_campaign(광고 ID)을 Play referrer·Apple ct 로 넘겨 바로 스토어를 연다(/go/ 페이지와 같은 규칙).
// 데스크톱·크롤러(메타 심사 봇 포함)는 그대로 랜딩을 본다.
const APPLE_CAMPAIGN_STORE = 'https://apps.apple.com/app/apple-store/id6793513720';
const APPLE_PROVIDER_TOKEN = '128831841';
// 맞춤형 제품 페이지(App Store Connect 'meta-ads-2026-11', 2026-11-04 심사 제출) — 광고 유입만 새 스크린샷 6장짜리
// 페이지로 보낸다. 승인 전·비활성 상태에선 App Store 가 ppid 를 무시하고 기본 제품 페이지를 연다.
const APPLE_PRODUCT_PAGE = 'd3bcf254-39dc-4e35-94cb-25c69d03ba63';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  path: string; // 예: "/", "/invite.html"
  noindex?: boolean;
  canonical?: boolean;
  /** html lang — 기본 ko. /en.html 페이지가 en을 넘긴다. */
  lang?: string;
  /** 한/영 짝이 있는 페이지면 hreflang alternate 링크를 낸다 (랜딩만). */
  alternates?: boolean;
}
const { title, description, ogTitle = title, path, noindex = false, canonical = false, lang = 'ko', alternates = false } = Astro.props;
const url = new URL(path, Astro.site).href;
const alt = { ko: new URL('/', Astro.site).href, en: new URL('/en.html', Astro.site).href };
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline define:vars={{ playStore: PLAY_STORE, appleStore: APPLE_CAMPAIGN_STORE, appleToken: APPLE_PROVIDER_TOKEN, applePpid: APPLE_PRODUCT_PAGE }}>
    // 메타 광고 유입(utm_source=meta)의 모바일 기기는 랜딩 대신 스토어로 직행 — 가장 먼저 실행돼야 하므로 head 최상단.
    (function () {
      try {
        var q = new URLSearchParams(location.search);
        if (q.get('utm_source') !== 'meta') return;
        var ua = navigator.userAgent || '';
        var ios = /iPhone|iPad|iPod/i.test(ua);
        var android = /Android/i.test(ua);
        if (!ios && !android) return;
        var campaign = (q.get('utm_campaign') || 'meta').replace(/[^\w.-]/g, '').slice(0, 40);
        var url = ios
          ? appleStore + '?pt=' + appleToken + '&ct=' + encodeURIComponent(campaign) + '&mt=8' + (applePpid ? '&ppid=' + applePpid : '')
          : playStore + '&referrer=' + encodeURIComponent('utm_source=meta&utm_medium=paid&utm_campaign=' + campaign);
        location.replace(url);
      } catch (e) {
        // 파싱 실패 시 랜딩을 그대로 보여준다.
      }
    })();
  </script>
  {noindex && <meta name="robots" content="noindex" />}
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={ogTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'ko_KR'} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content="https://rougether.com/assets/og-cover.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="628" />
  <meta name="twitter:card" content="summary_large_image" />
  <!-- 메타 비즈니스 도메인 인증 (Business Suite → Settings → Domains → rougether.com) -->
  <meta name="facebook-domain-verification" content="h86nsl43g2uvrlhz12r7d0fxxywgyg" />
  {canonical && <link rel="canonical" href={url} />}
  {alternates && <link rel="alternate" hreflang="ko" href={alt.ko} />}
  {alternates && <link rel="alternate" hreflang="en" href={alt.en} />}
  {alternates && <link rel="alternate" hreflang="x-default" href={alt.ko} />}
  <!-- 구글 검색결과 로고용 고해상도 파비콘 — 48px 배수의 정사각형이어야 인식된다. -->
  <link rel="icon" type="image/png" sizes="96x96" href="/assets/favicon-96.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/favicon-192.png" />
  <link rel="icon" type="image/png" sizes="48x48" href="/assets/favicon.png" />
  <link rel="apple-touch-icon" href="/assets/icon.png" />
  <link rel="preload" href="/fonts/NanumSquareRoundR.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/NanumSquareRoundEB.woff2" as="font" type="font/woff2" crossorigin />
  <!-- GA4 — 페이지뷰·유입 채널·아웃바운드 클릭은 향상된 측정이 자동 수집. -->
  <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
  <script is:inline define:vars={{ GA_ID }}>
    window.dataLayer = window.dataLayer || [];
    // define:vars는 이 스크립트를 즉시실행함수로 감싼다 — `function gtag(){}` 선언은 그 안에
    // 갇혀 전역이 되지 않았고, 아래 클릭 핸들러들이 ReferenceError로 죽어 appstore_tap이
    // 2026-09-07~24 동안 통째로 유실됐다. 반드시 window에 단다 (smoke가 검사).
    window.gtag = function () { dataLayer.push(arguments); };
    gtag('js', new Date());
    gtag('config', GA_ID);
  </script>
  <slot name="head" />
</head>
<body>
  <slot />
  <script is:inline>
    // 목표 행동 계측 — App Store 링크 탭을 위치(placement)별로 구분해 GA4 이벤트로 보낸다.
    // transport_type beacon: 클릭 직후 새 탭으로 전환돼도 전송이 유실되지 않는다
    // (기본 전송은 페이지가 백그라운드로 가면 드랍되는 사례가 실측됨).
    document.querySelectorAll('[data-cta]').forEach(function (el) {
      el.addEventListener('click', function () {
        gtag('event', 'appstore_tap', { placement: el.dataset.cta, transport_type: 'beacon' });
      });
    });
    // 웹앱 진입(app.rougether.com) — App Store 탭과 별도 이벤트로 센다(목표 지표 오염 방지).
    document.querySelectorAll('[data-web-cta]').forEach(function (el) {
      el.addEventListener('click', function () {
        gtag('event', 'webapp_open', { placement: el.dataset.webCta, transport_type: 'beacon' });
      });
    });
  </script>
</body>
</html>
