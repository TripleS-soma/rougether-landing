---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import StoreBadges from '../components/StoreBadges.astro';
import TourRow from '../components/TourRow.astro';
import Faq, { FAQ_ITEMS } from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import EasterCats from '../components/EasterCats.astro';
import '../styles/landing.css';
import { SITE, APP_STORE, INSTAGRAM, GITHUB, WEB_APP } from '../lib/links';

// 검색 타이틀은 토스처럼 브랜드 단독 — 설명은 meta description이 맡는다.
// 카톡/SNS 공유 카드(og:title)는 맥락이 필요해 태그라인 버전을 유지.
const TITLE = '루게더';
const OG_TITLE = '루게더 — 내 캐릭터와, 친구들과 한 집에서 함께 크는 할 일 관리 앱';
const DESC = '내 캐릭터와, 친구들과 한 집에서 함께 크는 할 일 관리 앱, 루게더. 루틴을 지키면 방이 자라요.';

const appLd = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: '루게더',
  alternateName: 'Rougether',
  description: DESC,
  url: `${SITE}/`,
  image: `${SITE}/assets/og-cover.jpg`,
  operatingSystem: 'iOS',
  applicationCategory: 'LifestyleApplication',
  installUrl: APP_STORE,
  sameAs: [INSTAGRAM],
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'KRW' },
  author: { '@type': 'Organization', name: 'TripleS', url: GITHUB },
};

// FAQ 구조화 데이터는 화면의 FAQ_ITEMS에서 그대로 생성 — 내용 불일치가 구조적으로 불가능하다.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ_ITEMS.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base title={TITLE} ogTitle={OG_TITLE} description={DESC} path="/" canonical>
  <Fragment slot="head">
    <meta name="naver-site-verification" content="8e47021569ff94eaf80482a41245d3082f676959" />
    <script is:inline>document.documentElement.className += ' js';</script>
    <script type="application/ld+json" set:html={JSON.stringify(appLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <Header />

  <!-- 카피·캡처는 App Store 스크린샷(2026-09)과 동일 — 스토어에서 본 앱을 랜딩에서 그대로 만나게 -->
  <section class="hero">
    <div class="wrap cols">
      <div class="copy">
        <h1>루틴을 지키면<br /><span class="accent">내 방이 자라요</span></h1>
        <p class="lead">내 캐릭터와, 친구들과 한 집에서 함께 크는 할 일 관리 앱, 루게더.</p>
        <div class="badges" id="download">
          <StoreBadges placement="hero" />
        </div>
        <p class="web-link"><a href={WEB_APP} data-web-cta="hero">PC에서 설치 없이 웹으로 시작하기 →</a></p>
      </div>
      <div class="phone">
        <img src="/assets/screens/hero-room.jpg" alt="루게더 내 방 화면 — 캐릭터가 쉬고 있는 노란 방과 오늘의 할 일" />
      </div>
    </div>
    <a class="scroll-hint" href="#tour" aria-label="아래로 스크롤해서 더 알아보기">
      <span>스크롤해서 더 알아보기</span>
      <svg width="26" height="40" viewBox="0 0 26 40" aria-hidden="true">
        <rect x="1.5" y="1.5" width="23" height="37" rx="11.5" fill="none" stroke="currentColor" stroke-width="3" />
        <rect class="wheel" x="11" y="9" width="4" height="8" rx="2" fill="currentColor" />
      </svg>
    </a>
  </section>

  <section class="tour" id="tour">
    <div class="wrap">
      <TourRow img="/assets/screens/tour-routines.jpg" alt="오늘의 할 일 화면 — 모닝·건강·성장 카테고리와 곰 체크" num={1} desc="모닝·건강·성장처럼 카테고리로 묶고, 알림 시간까지 딱 정해요">
        매일의 할 일을<br /><span class="accent">가볍게 체크</span>
      </TourRow>
      <TourRow img="/assets/screens/tour-decor.jpg" alt="방 꾸미기 화면 — 가구·소품·벽지·바닥 탭과 적용하기" num={2} desc="체크로 모은 코인으로 가구·소품·벽지·바닥을 골라 내 방을 꾸며요">
        가구부터 벽지까지<br /><span class="accent">내 취향대로</span>
      </TourRow>
      <TourRow img="/assets/screens/tour-house.jpg" alt="집 화면 — 친구 넷의 방이 모인 구름 위의 집, 집 레벨과 구성원" num={3} desc="초대코드로 모인 친구들의 방이 한 집에 — 함께 지킨 루틴이 집 레벨을 올려요">
        친구들과 한 집에서<br /><span class="accent">함께 쌓는 루틴</span>
      </TourRow>
      <TourRow img="/assets/screens/tour-calendar.jpg" alt="달력 화면 — 완료한 날에 점이 찍힌 9월 달력과 그날의 할 일" num={4} desc="지킨 날마다 달력에 점이 찍히고, 주간 회고로 한 주를 돌아봐요">
        차곡차곡 쌓인 하루<br /><span class="accent">달력에서 한눈에</span>
      </TourRow>
    </div>
  </section>

  <!-- 웹앱(PWA) 진입 — 데스크톱·앱 미설치 이용자용. 설치(홈 화면 추가)는 app.rougether.com 자체 도메인에서만 가능하므로 여기선 안내만. -->
  <section class="web" id="web">
    <div class="wrap reveal">
      <p class="eyebrow">웹에서도</p>
      <h2>PC에서도, 설치 없이<br /><span class="accent">브라우저에서 바로</span></h2>
      <a class="web-btn" href={WEB_APP} data-web-cta="section">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="14" rx="2.5"/><path d="M8 21h8M12 18v3"/></svg>
        웹에서 루게더 열기
      </a>
      <p class="web-url">app.rougether.com</p>
      <ul class="steps" aria-label="앱처럼 설치하는 방법">
        <li><b>Chrome · Edge</b><span>주소창 오른쪽 <em>설치</em> 아이콘</span></li>
        <li><b>Mac Safari</b><span>파일 메뉴 → <em>Dock에 추가</em></span></li>
        <li><b>휴대폰 브라우저</b><span>공유 → <em>홈 화면에 추가</em></span></li>
      </ul>
    </div>
  </section>

  <Faq />

  <section class="closing">
    <div class="wrap reveal">
      <h2>루게더에 오신 걸 환영해요</h2>
      <p>루틴을 지키면 내 방이 자라요 — 친구들과 한 집에서 함께 시작해보세요.</p>
      <div class="badges">
        <StoreBadges placement="closing" />
      </div>
    </div>
  </section>

  <Footer />

  <EasterCats />

  <script is:inline>
    // 스크롤 리빌 — 뷰포트 진입 시 1회 노출. reduced-motion에선 CSS가 무효라 no-op.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        e.target.classList.add('in');
        io.unobserve(e.target);
      }
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</Base>
