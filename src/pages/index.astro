---
import Landing from '../components/Landing.astro';
---

<!-- 루트 언어 처리 (2026-09-29 변경): 브라우저 언어로 자동 이동하지 않는다.
     구글봇은 미국·영어 로케일로 렌더링하므로, navigator.languages 기반 JS 리다이렉트는 한국어 루트를
     /en.html 로 넘기는 페이지로 보이게 만든다(구글도 자동 언어 리다이렉트를 권장하지 않음).
     그래서 이동은 사람이 고른 경우만 — ?lang=(드롭다운·공유 링크) 또는 한 번 고른 선택(localStorage).
     한국어가 아닌 브라우저에는 Landing.astro 의 영어 안내 배너만 보여준다. -->
<script is:inline>
  (function () {
    try {
      var q = new URLSearchParams(location.search).get('lang');
      if (q === 'ko' || q === 'en') { localStorage.setItem('rougether.lang', q); }
      var chosen = q || localStorage.getItem('rougether.lang');
      if (chosen === 'en') { location.replace('/en.html' + location.search + location.hash); }
    } catch (e) {}
  })();
</script>
<Landing locale="ko" />
