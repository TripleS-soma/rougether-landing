---
import Base from '../layouts/Base.astro';
import InviteCard from '../components/InviteCard.astro';
import { INVITE_COPY } from '../i18n';

// 한국어로 렌더하고, 브라우저 언어가 한국어가 아니면(또는 ?lang=en) 카드 스크립트가 영어로 바꾼다.
const copy = INVITE_COPY.invite;
---

<Base
  title={copy.ko.title}
  description={copy.ko.description}
  ogTitle="루게더에 초대받았어요 🎁"
  path="/invite.html"
  noindex
>
  <InviteCard copy={copy} scheme="invite" placement="invite" visual="mark" />
</Base>
